# Copiar como backend\.env en el SERVIDOR (no se sube a Git) y rellenar.
ENTORNO=produccion
# Generar con: (desde backend\)  set PYTHONPATH=.  y  .venv\Scripts\python scripts\crear_admin.py clave-secreta
SECRET_KEY=PEGAR_AQUI_LA_CLAVE_GENERADA
COOKIE_SECURE=true
# El nombre que TI asigne al servidor
CORS_ORIGINS=https://sistema.empresa.local
DATABASE_URL=sqlite+aiosqlite:///./local_db.sqlite3
AUTH_ENABLED=true
